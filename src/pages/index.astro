peat(4,1fr);margin-top:65px;border-top:1px solid #dfe3e7;border-left:1px solid #dfe3e7}.service{padding:28px;border-right:1px solid #dfe3e7;border-bottom:1px solid #dfe3e7;min-height:190px}.service span{font-size:11px;color:#9aa5b0}.service h3{font-size:19px;margin:32px 0 10px}.service p{font-size:13px;color:var(--muted);line-height:1.5;margin:0}.text-link{display:inline-block;margin-top:30px;font-weight:800;font-size:14px}.reviews{background:#f5f6f7}.review-head{display:flex;justify-content:space-between;align-items:end}.rating{text-align:right}.rating b{font-size:40px;display:block}.rating span{letter-spacing:2px}.rating small{display:block;color:var(--muted);margin-top:5px}.review-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:55px 0 30px}.review{background:#fff;padding:28px;border:1px solid #e1e5e9}.stars{font-size:13px;letter-spacing:3px;margin-bottom:20px}.review p{font-size:17px;line-height:1.6;margin:0 0 30px}.review footer{display:flex;justify-content:space-between;gap:20px;font-size:12px}.review footer span{color:#7c8792}.outline{border:1px solid #cbd2d9}.faq-wrap{background:#fff}.faq-wrap details{max-width:820px;border-bottom:1px solid #dfe3e7;padding:24px 0}.faq-wrap summary{cursor:pointer;font-weight:800;font-size:17px;list-style:none}.faq-wrap summary::-webkit-details-marker{display:none}.faq-wrap p{color:var(--muted);max-width:700px;line-height:1.7}.final-cta{background:var(--blue);color:#fff;padding:100px 0}.final-cta h2{font-size:clamp(42px,6vw,72px);letter-spacing:-.055em;line-height:1;margin:0}.final-cta p:not(.eyebrow){color:#b8c8d8;margin:24px 0 32px}.final-cta .primary{display:inline-flex}footer{background:#0b121a;color:#aeb9c3;padding:40px 0}footer .container{display:flex;align-items:center;gap:30px}footer b{color:#fff}footer span{font-size:12px}footer small{margin-left:auto;font-size:11px}@media(max-width:800px){.nav-links a:not(.nav-cta){display:none}.hero{min-height:680px}.hero-content{padding-top:90px}.trust{flex-direction:column;gap:10px;margin-top:50px}.problem{grid-template-columns:1fr;gap:30px}.section{padding:80px 0}.service-grid{grid-template-columns:repeat(2,1fr)}.review-grid{grid-template-columns:1fr}.review-head{align-items:start;gap:30px;flex-direction:column}.rating{text-align:left}footer .container{flex-direction:column;align-items:start;gap:12px}footer small{margin-left:0}}@media(max-width:480px){.container{width:min(100% - 28px,1120px)}.hero h1{font-size:48px}.actions{flex-direction:column;align-items:stretch}.btn{justify-content:center}.service-grid{grid-template-columns:1fr}.service{min-height:auto}.hero{min-height:720px}}
</style>
